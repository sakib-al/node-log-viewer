{
  "name": "node-log-viewer",
  "version": "0.1.0",
  "description": "Date-wise file logging for Node.js and NestJS with an embedded web UI log viewer and a plugin system (Discord notifications built in).",
  "keywords": [
    "logger",
    "log-viewer",
    "logging",
    "nestjs",
    "express",
    "discord",
    "log viewer ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakib-al/node-log-viewer.git"
  },
  "homepage": "https://github.com/sakib-al/node-log-viewer#readme",
  "bugs": {
    "url": "https://github.com/sakib-al/node-log-viewer/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest.d.ts",
        "default": "./dist/nest.js"
      },
      "require": {
        "types": "./dist/nest.d.cts",
        "default": "./dist/nest.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "nest": [
        "./dist/nest.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "pnpm run build:ui && pnpm run build:lib",
    "build:ui": "pnpm --filter node-log-viewer-ui build",
    "build:lib": "tsup",
    "dev:ui": "pnpm --filter node-log-viewer-ui dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0",
    "@nestjs/core": ">=9.0.0",
    "reflect-metadata": ">=0.1.13"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.2.3",
    "@types/node": "^26.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
